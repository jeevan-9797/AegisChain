# AegisChain Environment Configuration
# Copy this file to .env and configure your keys for local development.
# Do NOT commit .env to version control.

# Provider: 'google' (Google AI Studio proxy) or 'sap_hub' (SAP Generative AI Hub)
LLM_PROVIDER=google

# Google AI Studio Model: gemini-flash-lite-latest (fast & reliable) or gemini-3.8-flash
GEMINI_MODEL=gemini-flash-lite-latest

# Google AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SAP AI Core / Generative AI Hub configuration (when provisioned in SAP BTP)
# BTP_AICORE_CLIENT_ID=
# BTP_AICORE_CLIENT_SECRET=
# BTP_AICORE_AUTH_URL=
# BTP_AICORE_BASE_URL=
# BTP_AICORE_RESOURCE_GROUP=default
# AI_HUB_MODEL_DEPLOYMENT_ID=
