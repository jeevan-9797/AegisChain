{
  "_version": "1.90.0",
  "sap.app": {
    "id": "com.aegis.controltower",
    "type": "application",
    "i18n": {
      "bundleName": "com.aegis.controltower.i18n.i18n",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "e7d7797d-ce27-45ea-a9aa-bbd4ef8347c7"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.aegis.controltower.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": "",
          "async": true
        }
      },
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/mock.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.aegis.controltower.view",
        "async": true,
        "viewPath": "com.aegis.controltower.view"
      },
      "routes": [
        {
          "name": "RouteControlTower",
          "pattern": ":?query:",
          "target": [
            "TargetControlTower"
          ]
        }
      ],
      "targets": {
        "TargetControlTower": {
          "id": "ControlTower",
          "name": "ControlTower"
        }
      }
    },
    "rootView": {
      "viewName": "com.aegis.controltower.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}